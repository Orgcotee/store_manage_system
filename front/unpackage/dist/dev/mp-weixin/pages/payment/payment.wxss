.radio-wrapper.data-v-031d9d14 {
  position: absolute;
  right: 30rpx;
  top: 50%;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
}
.pay-main.data-v-031d9d14 {
	padding: 20rpx 30rpx;
}
.pay-item.data-v-031d9d14 {
	display: block;
	margin-bottom: 20rpx;
	border-radius: 16rpx;
	background: #fff;
	box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
	transition: all 0.2s;
}
.pay-item.selected.data-v-031d9d14 {
	border: 2rpx solid #FF3333;
	-webkit-transform: scale(1.02);
	        transform: scale(1.02);
}
.item-content.data-v-031d9d14 {
	position: relative;
	display: flex;
	align-items: center;
	padding: 30rpx 100rpx 30rpx 30rpx; /* 右侧留出radio空间 */
}
.pay-img.data-v-031d9d14 {
	width: 80rpx;
	height: 80rpx;
	margin-right: 30rpx;
}
.pay-info.data-v-031d9d14 {
	flex: 1;
}
.pay-title.data-v-031d9d14 {
	font-size: 32rpx;
	font-weight: 500;
	color: #333;
}
.pay-txt.data-v-031d9d14 {
	font-size: 24rpx;
	color: #999;
	margin-top: 8rpx;
}
radio.data-v-031d9d14 {
  -webkit-transform: scale(0.9);
          transform: scale(0.9);
}
