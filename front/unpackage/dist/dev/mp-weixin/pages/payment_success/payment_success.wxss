          animation: scaleUp-data-v-31934d9c 0.6s ease-in-out;
}
.checkmark.data-v-31934d9c {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 60rpx;
  height: 100rpx;
  border: solid #fff;
  border-width: 0 8rpx 8rpx 0;
  -webkit-transform: translate(-50%, -60%) rotate(45deg);
          transform: translate(-50%, -60%) rotate(45deg);
}
@-webkit-keyframes scaleUp-data-v-31934d9c {
0% { -webkit-transform: scale(0); transform: scale(0);
}
60% { -webkit-transform: scale(1.1); transform: scale(1.1);
}
100% { -webkit-transform: scale(1); transform: scale(1);
}
}
@keyframes scaleUp-data-v-31934d9c {
0% { -webkit-transform: scale(0); transform: scale(0);
}
