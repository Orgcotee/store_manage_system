  font-size: 28rpx;
  -webkit-transform: translateX(20rpx);
          transform: translateX(20rpx);
}
.divider-line.data-v-a9dafa74 {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 2rpx;
  background: #e5e5e5;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
}
