<view class="container data-v-ac89e300"><view class="form-container data-v-ac89e300"><view class="form-item data-v-ac89e300"><text class="form-label data-v-ac89e300">申请人：</text><view class="picker disabled-text data-v-ac89e300">{{''+(loginer||'未获取到申请人信息')+''}}</view></view><view class="form-item data-v-ac89e300"><text class="form-label data-v-ac89e300">工号：</text><view class="picker disabled-text data-v-ac89e300">{{''+(loginerId||'未获取到申请人工号')+''}}</view></view><view class="form-item data-v-ac89e300"><text class="form-label data-v-ac89e300">报账类型：</text><picker value="{{typeIndex}}" range="{{reimburseTypes}}" data-event-opts="{{[['change',[['selectType',['$event']]]]]}}" bindchange="__e" class="data-v-ac89e300"><view class="picker data-v-ac89e300">{{''+(selectedType||'请选择类型')+''}}</view></picker></view><view class="form-item data-v-ac89e300"><text class="form-label data-v-ac89e300">金额（元）：</text><input class="input data-v-ac89e300" type="number" placeholder="请输入金额" data-event-opts="{{[['input',[['__set_model',['$0','amount','$event',[]],['formData']]]]]}}" value="{{formData.amount}}" bindinput="__e"/></view><view class="form-item data-v-ac89e300"><text class="form-label data-v-ac89e300">报账详情：</text><textarea class="textarea data-v-ac89e300" placeholder="请输入详细报账内容" maxlength="{{200}}" data-event-opts="{{[['input',[['__set_model',['$0','details','$event',[]],['formData']]]]]}}" value="{{formData.details}}" bindinput="__e"></textarea></view><button data-event-opts="{{[['tap',[['submitApplication',['$event']]]]]}}" class="submit-btn data-v-ac89e300" bindtap="__e">提交申请</button></view><view class="history-container data-v-ac89e300"><view class="section-title data-v-ac89e300">报账记录</view><scroll-view class="list-container data-v-ac89e300" scroll-y="{{true}}"><block wx:for="{{applications}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="list-item data-v-ac89e300"><view class="info-box data-v-ac89e300"><view class="header data-v-ac89e300"><text class="applicant data-v-ac89e300">{{item.employeeId+item.employeeName}}</text><text class="{{['data-v-ac89e300','status',item.approvalStatus]}}">{{statusMap[item.approvalStatus]}}</text></view><view class="detail-row data-v-ac89e300"><text class="label data-v-ac89e300">类型：</text><text class="value data-v-ac89e300">{{item.reimburseType}}</text></view><view class="detail-row data-v-ac89e300"><text class="label data-v-ac89e300">金额：</text><text class="amount data-v-ac89e300">{{"￥"+item.amount}}</text></view><view class="meta data-v-ac89e300"><text class="time data-v-ac89e300">{{item.applyTime}}</text><block wx:if="{{item.approver}}"><text class="approver data-v-ac89e300">{{"审批人："+item.approver}}</text></block></view><block wx:if="{{item.details}}"><view class="details data-v-ac89e300">{{"详情："+item.details}}</view></block><block wx:if="{{item.remark!=null&&item.approvalStatus==='approved'}}"><view class="remark-approved data-v-ac89e300">{{"审批意见："+item.remark}}</view></block><block wx:if="{{item.remark!=null&&item.approvalStatus==='rejected'}}"><view class="remark-rejected data-v-ac89e300">{{"审批意见："+item.remark}}</view></block></view></view></block></scroll-view></view><uni-popup vue-id="e4b17af4-1" type="message" data-ref="successPopup" class="data-v-ac89e300 vue-ref" bind:__l="__l" vue-slots="{{['default']}}"><uni-popup-message vue-id="{{('e4b17af4-2')+','+('e4b17af4-1')}}" type="success" message="提交成功" class="data-v-ac89e300" bind:__l="__l"></uni-popup-message></uni-popup></view>