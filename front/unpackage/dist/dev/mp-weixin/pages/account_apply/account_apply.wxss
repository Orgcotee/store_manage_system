.disabled-text.data-v-ac89e300 {
  color: #999 !important;         /* 浅灰色文字 */
  background-color: #f5f5f5;      /* 浅灰色背景 */
  cursor: not-allowed;            /* 禁用光标 */
  opacity: 0.9;                   /* 轻微透明效果 */
}
