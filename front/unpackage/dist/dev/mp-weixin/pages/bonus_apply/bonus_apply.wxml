<view class="container data-v-5987adb8"><view class="form-container data-v-5987adb8"><view class="form-item data-v-5987adb8"><text class="form-label data-v-5987adb8">申请人：</text><view class="picker disabled-text data-v-5987adb8">{{''+(loginer||'未获取到申请人信息')+''}}</view></view><view class="form-item data-v-5987adb8"><text class="form-label data-v-5987adb8">工号：</text><view class="picker disabled-text data-v-5987adb8">{{''+(loginerId||'未获取到申请人工号')+''}}</view></view><view class="form-item data-v-5987adb8"><text class="form-label data-v-5987adb8">奖金类型：</text><picker value="{{typeIndex}}" range="{{bonusTypes}}" data-event-opts="{{[['change',[['selectType',['$event']]]]]}}" bindchange="__e" class="data-v-5987adb8"><view class="picker data-v-5987adb8">{{''+(selectedType||'请选择类型')+''}}</view></picker></view><view class="form-item data-v-5987adb8"><text class="form-label data-v-5987adb8">金额（元）：</text><input class="input data-v-5987adb8" type="number" placeholder="请输入金额" data-event-opts="{{[['input',[['__set_model',['$0','amount','$event',[]],['formData']]]]]}}" value="{{formData.amount}}" bindinput="__e"/></view><view class="form-item data-v-5987adb8"><text class="form-label data-v-5987adb8">申请原因：</text><textarea class="textarea data-v-5987adb8" placeholder="请输入详细申请理由" maxlength="{{200}}" data-event-opts="{{[['input',[['__set_model',['$0','reason','$event',[]],['formData']]]]]}}" value="{{formData.reason}}" bindinput="__e"></textarea></view><view class="form-item data-v-5987adb8"><text class="form-label data-v-5987adb8">证明材料：</text><button data-event-opts="{{[['tap',[['uploadImage',['$event']]]]]}}" class="upload-btn data-v-5987adb8" bindtap="__e">上传附件</button><block wx:if="{{formData.img}}"><text class="file-name data-v-5987adb8">{{fileName}}</text></block></view><button data-event-opts="{{[['tap',[['submitApplication',['$event']]]]]}}" class="submit-btn data-v-5987adb8" bindtap="__e">提交申请</button></view><view class="history-container data-v-5987adb8"><view class="section-title data-v-5987adb8">申请记录</view><scroll-view class="list-container data-v-5987adb8" scroll-y="{{true}}"><block wx:for="{{applications}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="list-item data-v-5987adb8"><view class="info-box data-v-5987adb8"><view class="header data-v-5987adb8"><text class="applicant data-v-5987adb8">{{item.employeeId+item.employeeName}}</text><text class="{{['data-v-5987adb8','status',item.approvalStatus]}}">{{statusMap[item.approvalStatus]}}</text></view><view class="detail-row data-v-5987adb8"><text class="label data-v-5987adb8">类型：</text><text class="value data-v-5987adb8">{{item.category}}</text></view><view class="detail-row data-v-5987adb8"><text class="label data-v-5987adb8">金额：</text><text class="amount data-v-5987adb8">{{"￥"+item.amount}}</text></view><view class="meta data-v-5987adb8"><text class="time data-v-5987adb8">{{"申请时间："+item.applyTime}}</text></view><block wx:if="{{item.approvalStatus==='approved'||item.approvalStatus==='rejected'}}"><view class="meta data-v-5987adb8"><text class="time data-v-5987adb8">{{"审批时间："+item.dealTime}}</text><block wx:if="{{item.approver}}"><text class="approver data-v-5987adb8">{{"审批人："+item.approver}}</text></block></view></block><block wx:if="{{item.remark&&item.approvalStatus==='approved'}}"><view class="remark-approved data-v-5987adb8">{{'审批意见：'+item.remark+''}}</view></block><block wx:if="{{item.remark&&item.approvalStatus==='rejected'}}"><view class="remark-rejected data-v-5987adb8">{{'审批意见：'+item.remark+''}}</view></block></view></view></block></scroll-view></view><uni-popup vue-id="d76d073c-1" type="message" data-ref="successPopup" class="data-v-5987adb8 vue-ref" bind:__l="__l" vue-slots="{{['default']}}"><uni-popup-message vue-id="{{('d76d073c-2')+','+('d76d073c-1')}}" type="success" message="提交成功" class="data-v-5987adb8" bind:__l="__l"></uni-popup-message></uni-popup></view>